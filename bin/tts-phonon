#!/bin/bash
set -euo pipefail

tts_script="${BASH_SOURCE[0]}"
while [ -h "$tts_script" ]; do
  tts_script_dir="$(cd -P "$(dirname "$tts_script")" && pwd)"
  tts_script="$(readlink "$tts_script")"
  case "$tts_script" in /*) ;; *) tts_script="$tts_script_dir/$tts_script" ;; esac
done
tts_root="$(cd -P "$(dirname "$tts_script")/.." && pwd)"
# No environment of its own: the launcher speaks to Ollama over HTTP and uses
# only the standard library. PHONON_PYTHON selects another interpreter for
# testing. Unlike tts-qwen, --setup stays in the Python file, because there is
# no runtime to create before it can run.
tts_python="${PHONON_PYTHON:-$(command -v python3 || true)}"

if [ -z "$tts_python" ] || [ ! -x "$tts_python" ]; then
  if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then
    printf '%s\n' 'tts-phonon: local speech with the fixed Phonon voices served by Ollama.' \
      'English is the default. It needs python3 on your command search path.' \
      'Run tts-phonon --help again once python3 is available for all options.'
    exit 0
  fi
  printf '%s\n' 'python3 was not found. Install the Xcode command line tools' \
    '(xcode-select --install), or point PHONON_PYTHON at an interpreter.' >&2
  exit 1
fi
exec "$tts_python" "$tts_root/bin/tts-phonon.py" "$@"
